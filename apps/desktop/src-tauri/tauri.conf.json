{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PheWAS Browser",
  "version": "0.5.0",
  "identifier": "edu.columbia.cumc.phewas-browser",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PheWAS Browser",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Medical",
    "shortDescription": "Local browser for variant-level PheWAS summary statistics",
    "longDescription": "Browse variant-level PheWAS summary statistics offline. Import a summary-statistics file, keep several datasets side by side, and explore genes, variants and phenotypes. Research Use Only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
